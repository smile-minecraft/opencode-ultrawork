  "bugs": {
    "url": "https://github.com/smile-minecraft/opencode-ultrawork/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "ai",
    "agents",
    "workflow",
    "tdd",
    "bun",
    "typescript"
  ],
  "files": [
    "src",
    "index.ts",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts"
  },
  "engines": {
    "opencode": ">=2.0.16"
  },
  "scripts": {
    "test": "bun test",
    "test:v2": "bun test tests/v2/",
