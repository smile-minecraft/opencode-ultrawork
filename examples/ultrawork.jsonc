{
  // 這個檔案是 ultrawork.jsonc 的完整範例：把需要的部分複製到
  // <專案根目錄>/.ultrawork/ultrawork.jsonc（專案層）或
  // <OpenCode 全域設定資料夾>/.ultrawork/ultrawork.jsonc（全域層）即可。
  // 兩層格式相同，先套內建預設值，再疊全域，最後疊專案。
  // 每個欄位都選填，這裡把全部可能的欄位都列出來當參考。
  "$schema": "https://raw.githubusercontent.com/smile-minecraft/opencode-ultrawork/main/schema/ultrawork.schema.json",

  "modules": {
    // 模組開關。關掉的模組不註冊它的工具與 hook，其餘維持預設開啟。
    "search": true,
    "verification": true,
    "commentSignal": true,
    "skills": true,
    "skiller": true,
    "workflow": true,
    // 診斷工具在正式專案通常不需要，這裡示範關掉一個。
    "diagnostics": false,
    "memory": true
  },

  "skiller": {
    // 個人技能目錄。預設 ~/.agents/skills
    // 注意：這兩個 key 只採全域層的值，寫在專案層會被忽略並警告。
    "personalSkillRoot": "~/.agents/skills",
    // 晉升／退役時改寫的角色檔目錄。auto = <OpenCode 全域設定資料夾>/agents
    "agentsDir": "auto"
  },

  "skills": {
    // 技能清單在 system prompt 的呈現：index = 只列名稱，full = OpenCode 原本的完整清單
    "catalog": "index"
  },

  "verification": {
    // 能呼叫 verification_run 的 agent。預設只有 momus
    "runAllowedAgents": ["momus"],
    // 能呼叫 change-scope-check 的 agent。預設 build 與 ultra
    "scopeCheckAllowedAgents": ["build", "ultra"]
  },

  "memory": {
    "writerAgents": ["memorizer"], // 只允許寫在全域設定
    "inject": true,
    // 兩層記憶各自的預算，全部選填（沒寫的欄位用內建預設）。
    // budget.global 只允許寫在全域設定，寫在專案層會被忽略並警告；
    // budget.project 兩層都能寫，專案層只影響專案層記憶。
    "budget": {
      // "global": { "indexCharLimit": 3000 },
      "project": {
        "indexCharLimit": 3000, // 該層索引上限，超過就拒絕寫入
        "topicCharLimit": 4000, // 單一主題檔上限
        "descriptionCharLimit": 120, // 索引每行 description 上限
        "maxTopics": 0, // 該層主題數上限，0 = 不限制；超過只擋新增
        "pinnedLimit": 3, // pinned 主題數上限
        "pinnedInjectBudget": 2500, // 注入 pinned 正文的總預算（展示截斷）
        "noteCharLimit": 1000 // 單筆 memory-note 上限
      }
    }
  },
  "workflow": {
    "completion": {
      // memory 模組開啟時，任務完成前要先有有效的記憶處置。
      // memory 關掉時這個值不作用，完成前檢查會自行放行。
      "requireMemoryDisposition": true
    },
    "evidencePack": {
      // 派發時強制檢查實作說明七節格式的 subagent 名單。
      // 空陣列代表不再檢查；改完要重新載入才生效。
      "gatedSubagents": ["implementer", "debugger", "ultra-coder"]
    }
  }
}
